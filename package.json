    "format.fix": "oxfmt --write .",
    "typecheck": "agent-native typecheck",
    "migrate:shared": "tsx scripts/migrate-production.ts",
    "migrate:production": "tsx scripts/migrate-production.ts",
    "action": "agent-native action",
