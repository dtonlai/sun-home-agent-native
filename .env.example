# Shared PostgreSQL database (required for local Sun Home app runs)
# Use the Supabase transaction pooler URL for app runtime traffic.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres
# Use a direct or session connection for explicit migrations. Core selects this
# URL for the migration runtime when configured; never use a transaction pooler
# for migration work.
# DATABASE_URL_UNPOOLED=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Better Auth
# Generate a private local secret via: openssl rand -hex 32
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3000
# AUTH_DISABLED is false when unset. Use AUTH_DISABLED=true only for local QA.
# Google sign-in (optional; local development has a Better Auth dev account)
# GOOGLE_SIGN_IN_CLIENT_ID=
# GOOGLE_SIGN_IN_CLIENT_SECRET=

# AI providers
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Notion integration
# NOTION_API_KEY=

# Notion OAuth (for connecting user accounts — configure via the onboarding wizard)
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=

# Static bearer access (optional; not browser authentication)
# ACCESS_TOKEN=
